{
  "name": "mcu-debug-proxy",
  "publisher": "mcu-debug",
  "version": "0.1.16",
  "preview": true,
  "description": "A proxy server for MCU-Debug extension to handle remote VSCode debug sessions via WSL, Docker, SSH.",
  "displayName": "MCU-Debug Proxy Server",
  "keywords": [
    "MCU",
    "Cortex-Debug",
    "Mcu-Debug",
    "ARM",
    "RISC-V",
    "debugger"
  ],
  "homepage": "https://github.com/mcu-debug/mcu-debug#readme",
  "bugs": {
    "url": "https://github.com/mcu-debug/mcu-debug/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcu-debug/mcu-debug.git"
  },
  "license": "Apache-2.0",
  "author": "Haneef Mohammed <haneefdm@gmail.com>",
  "extensionKind": [
    "ui"
  ],
  "icon": "images/mcu-debug-proxy.png",
  "activationEvents": [
    "onCommand:mcu-debug-proxy.ping",
    "onDebugResolve:mcu-debug",
    "onStartupFinished"
  ],
  "categories": [
    "Debuggers"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "type": "commonjs",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcu-debug-proxy.startProxyServer",
        "title": "Start MCU Debug Proxy Server"
      },
      {
        "command": "mcu-debug-proxy.startReverseTunnel",
        "title": "Start Reverse Tunnel"
      },
      {
        "command": "mcu-debug-proxy.getRemoteSshHost",
        "title": "Get Remote SSH Host"
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "build": "npm run package",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "node ../../scripts/require-macos.js && npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@mcu-debug/shared": "*",
    "@types/hasbin": "^1.2.2",
    "@types/node": "^25.0.3",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.107.0",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/extension-telemetry": "^1.2.0",
    "esbuild": "^0.28.0",
    "esbuild-node-externals": "^1.20.1",
    "hasbin": "^1.2.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "tmp": "^0.2.5",
    "winston": "^3.19.0",
    "winston-vscode": "^1.0.0"
  }
}
